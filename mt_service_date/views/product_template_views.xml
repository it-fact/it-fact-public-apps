<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="product_template_form_view">
        <field name="name">product.template.common.form.inherit.mt_service_date</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='internal_notes']" position="after">
                <group name="service_date_options" string="Service Date Options">
                    <field name="service_date_only_months" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
