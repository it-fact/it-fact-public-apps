<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="report_invoice_document"
        inherit_id="account.report_invoice_document"
        priority="100"
    >
        <xpath
            expr="//div[@name='address_same_as_shipping']/t/address[@t-field='o.partner_id']"
            position="replace"
        >
            <!--
            <address class="mb-0" t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
        -->
        </xpath>
        <xpath
            expr="//div[@name='no_shipping']/t/address[@t-field='o.partner_id']"
            position="replace"
        >
            <!--
            <address class="mb-0" t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
        -->
        </xpath>
        <xpath
            expr="//div[@name='address_not_same_as_shipping']/t/address[@t-field='o.partner_id']"
            position="replace"
        >
            <!--
            <address class="mb-0" t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
        -->
        </xpath>
    </template>
</odoo>
